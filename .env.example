BOT_TOKEN=
BOT_USERNAME=
APP_URL=https://your-domain.example
ADMIN_DOCTOR_ID=0
DATABASE_PATH=mood.sqlite3
APP_TIMEZONE=Europe/Moscow
# Patient files sent to the bot (PDF / JPEG / PNG / WebP / DOC / DOCX).
# Default: <parent of DATABASE_PATH>/docs. Docker: same volume as sqlite.
# DOCS_DIR=/data/docs
# Alternative Telegram Bot API host (not an HTTP/SOCKS proxy), e.g. http://127.0.0.1:8081
# TELEGRAM_PROXY=
# Local UI only: skip Telegram initData and act as this user. Leave unset in production.
# DEV_TELEGRAM_ID=

# POST /api/dev/reset wipes ALL diary data (users, links, invites, answers, …)
# so /start and after-ОСР messages fire again. Requires header X-Dev-Reset-Token.
# If unset/empty, the endpoint refuses every request (403).
# DEV_RESET_TOKEN=

# Biweekly HADS reminders (sent by the bot process, not the API)
# REMINDER_INTERVAL_DAYS=14
# REMINDER_CHECK_SECONDS=3600

# Daily pills check-in uses APP_TIMEZONE calendar dates. After this hour
# the bot asks once if a regimen exists and there is no log / prompt yet today.
# Independent of the biweekly HADS reminder loop.
# PILLS_CHECKIN_HOUR=20
# PILLS_CHECKIN_HOUR_UTC is still read if PILLS_CHECKIN_HOUR is unset.
# PILLS_CHECK_SECONDS=3600

# Daily mood is the Mini App page /mood/ (POST /api/moods). Not Telegram
# inline buttons and not PANAS. ШПАНА stays one-time after first
# HADS/BAI/BDI (app.py panas_intro). Pills-diary Mini App is one-time
# after a completed HADS (app.py pills_intro), skipped if a regimen exists.
# TELEGRAM_PROXY is a Bot API host.

# Clinical RAG: any OpenAI-compatible API (OpenAI, local Ollama http://localhost:11434/v1, vLLM, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional dense retrieval in addition to BM25, e.g. text-embedding-3-small
EMBEDDING_MODEL=
GUIDELINES_DIR=guidelines
